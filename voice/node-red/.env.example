# Copy to `.env` beside docker-compose.yml and fill in. Never commit the result.

# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Host path to the Telegram downloader bot (contains the .session file)
TELEGRAM_BOT_DIR=/home/dell_jan/telegram-downloader

# Session file stem, i.e. "downloader" for downloader.session
TG_SESSION_NAME=downloader

# Where the bot posts progress: numeric chat id, @username, or "me"
TG_STATUS_CHAT=me

# Seconds before an unmoving progress message counts as stalled
TG_STALE_AFTER=120

# Default spoken language: en | hi | hinglish
VOICE_LANG=en

TZ=Asia/Kolkata
